{
  "name": "atlas-free-resource-directory",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test e2e/directory.spec.ts e2e/pwa.spec.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:links:update": "tsx scripts/check-links.ts --write",
    "report:links": "tsx scripts/render-audit.ts"
  },
  "dependencies": {
    "lucide-react": "^1.11.0",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
